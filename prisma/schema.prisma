generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customers Customer[]
  orders    Order[]
  users     User[]

  @@map("branches")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branchId String? @map("branch_id")

  orders Order[]

  @@index([branchId])
  @@index([role, isActive])
  @@map("users")
}

enum Role {
  STAFF
  ADMIN

  @@map("role")
}

model Customer {
  id String @id @default(cuid())

  name String
  phone String @unique

  qrUuid String @unique @default(uuid()) @map("qr_uuid") @db.Uuid

  currentCycleCount Int @default(0) @map("current_cycle_count")
  lifetimeCount     Int @default(0) @map("lifetime_count")

  kvkkConsent   Boolean   @default(false) @map("kvkk_consent")
  kvkkConsentAt DateTime? @map("kvkk_consent_at")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branchId String? @map("branch_id")

  orders  Order[]
  rewards Reward[]

  @@index([branchId])
  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

/// Server-side revocation list for customer session JWTs.
///
/// The customer session is a stateless signed cookie, so clearing the cookie
/// only removes the copy the browser happens to hold — a token captured from a
/// shared device, a proxy log or an XSS payload stays valid for its full TTL.
/// Logout writes the token's `jti` here and `getCustomerSession()` refuses any
/// token whose `jti` is present, which turns logout into a real invalidation.
///
/// Rows are disposable: once `expiresAt` has passed the token is rejected by
/// signature verification anyway, so expired rows are pruned on every write and
/// the table stays bounded by "logouts within one TTL window".
///
/// Deliberately NOT related to Customer with a foreign key — a revocation must
/// outlive the row it refers to (and `deleteCustomer` must not have to know
/// about this table to keep its transaction correct).
model RevokedCustomerSession {
  jti        String   @id @db.Uuid
  customerId String   @map("customer_id")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime @default(now()) @map("revoked_at")

  @@index([expiresAt])
  @@index([customerId])
  @@map("revoked_customer_sessions")
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerId String   @map("customer_id")

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branchId String? @map("branch_id")

  staff   User?   @relation(fields: [staffId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  staffId String? @map("staff_id")

  reward Reward?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@index([staffId, createdAt(sort: Desc)])
  @@map("orders")
}

model CampaignRule {
  id           String   @id @default(cuid())
  threshold    Int      @unique
  rewardName   String   @map("reward_name")
  isResetPoint Boolean  @default(false) @map("is_reset_point")
  isActive     Boolean  @default(true) @map("is_active")
  validDays    Int?     @map("valid_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rewards Reward[]

  @@index([isActive, threshold])
  @@map("campaign_rules")
}

model Reward {
  id        String       @id @default(cuid())
  status    RewardStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  claimedAt DateTime?    @map("claimed_at")
  expiresAt DateTime?    @map("expires_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerId String   @map("customer_id")

  rule   CampaignRule @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ruleId String       @map("rule_id")

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderId String @unique @map("order_id")

  @@index([customerId, status])
  @@index([ruleId])
  @@index([status, expiresAt])
  @@map("rewards")
}

enum RewardStatus {
  PENDING
  CLAIMED
  EXPIRED

  @@map("reward_status")
}
